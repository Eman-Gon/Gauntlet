# Gauntlet — env contract. Copy to .env and fill what each dispatch needs.
# Only ANTHROPIC_API_KEY or GMI_API_KEY + TAVILY_API_KEY are required at boot.
# Every other key may be blank: the service it gates is silently disabled until present.

# ── inference ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PREMIUM_MODEL=claude-sonnet-4-6

# Cheap tier — defaults to the Anthropic OpenAI-compatibility endpoint with
# Haiku 4.5. GMI_API_KEY takes priority when set (see below).
CHEAP_BASE_URL=
CHEAP_API_KEY=
CHEAP_MODEL=

# ── GMI Cloud / AgentBox ─────────────────────────────────────────────────────
# Primary inference provider and deploy target. Single key unlocks 200+ models
# via OpenAI-compatible REST. Base URL confirmed at hackathon.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# Model IDs: Provider/model-name format (e.g. Qwen/Qwen3-30B-A3B)
CHEAP_MODEL=Qwen/Qwen3-30B-A3B
MEDIUM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
MEDIUM_INPUT_PER_MTOK=0.80
MEDIUM_OUTPUT_PER_MTOK=2.60

# Injected by AgentBox at container runtime — DO NOT hardcode.
# These override GMI_API_KEY / GMI_BASE_URL when present.
GMI_MAAS_API_KEY=
GMI_MAAS_BASE_URL=
GMI_MODELS=

# ── evidence ─────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
TAVILY_API_KEY_BACKUP=
EXA_API_KEY=

# ── x402 paywall (optional) ──────────────────────────────────────────────────
X402_PAY_TO=
X402_PRICE_USD=0.01

# ── watch loop ───────────────────────────────────────────────────────────────
WATCH_ENABLED=true
WATCH_INTERVAL_S=30

# ── gauntlet agent-vetting layer ─────────────────────────────────────────────
TARGET_AGENT_URL=http://127.0.0.1:8020/agent
MEMORY_BACKEND=local
HYDRADB_URL=
HYDRADB_API_KEY=

# ── flags ────────────────────────────────────────────────────────────────────
# Magnific honest-ad stage. Magnific is not a sponsor at this hack; OFF.
HONEST_AD_ENABLED=false

# ── run knobs (cascade tuning) ────────────────────────────────────────────────
SEMAPHORE=8
JUDGE_CONFIDENCE_THRESHOLD=0.7
SCRAPE_TIMEOUT_S=10
LLM_TIMEOUT_S=45
CHEAP_LLM_TIMEOUT_S=8

# Cheap-tier pricing used only for dashboard spend estimates.
CHEAP_INPUT_PER_MTOK=0.05
CHEAP_OUTPUT_PER_MTOK=0.10
CHEAP_ATTEMPT_COST_USD=0.0002
